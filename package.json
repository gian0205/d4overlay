{
  "name": "d4overlay",
  "version": "0.1.0",
  "description": "Overlay para Diablo IV: drops dos bosses e guia de builds por classe (Electron / Overwolf ow-electron)",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "overwolf": {
    "packages": [
      "gep",
      "overlay"
    ]
  },
  "scripts": {
    "start": "ow-electron .",
    "start:electron": "electron .",
    "test": "node --test",
    "validate-data": "node scripts/validate-data.js",
    "d4data:sync": "node scripts/d4data/sync.js",
    "d4data:extract": "node scripts/d4data/extract.js",
    "d4data": "npm run d4data:sync && npm run d4data:extract && npm run validate-data",
    "d4companion": "node scripts/d4companion/sync.js",
    "dist": "ow-electron-builder --publish=never"
  },
  "build": {
    "appId": "com.d4overlay.app",
    "productName": "D4 Overlay",
    "files": [
      "src/**/*",
      "data/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraFiles": [
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@overwolf/ow-electron": "^42.7.1",
    "@overwolf/ow-electron-builder": "latest",
    "electron": "^42.11.6"
  }
}
